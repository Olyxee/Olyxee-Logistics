# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string (>=16 chars) used to sign session cookies (required in production)
SESSION_SECRET=change_me_to_a_long_random_string

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Resend API key for email sending: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Verified sender address on your own domain (e.g. notifications@yourdomain.com)
# Verify logistics.olyxee.com in Resend first; keep this as a plain address.
EMAIL_FROM_ADDRESS=notifications@logistics.olyxee.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API cross-origin
ALLOWED_ORIGINS=https://admin.example.com

# ─── SMS (SMSPortal) ─────────────────────────────────────────────────────────
# REST API credentials from https://smsportal.com dashboard.
# NOTE: sending is also gated by featureFlags.smsNotifications - credentials
# alone never activate the channel.
SMSPORTAL_CLIENT_ID=your_client_id
SMSPORTAL_API_SECRET=your_api_secret
# Optional registered/branded sender ID
SMS_SENDER_ID=YourBrand

# ─── Billing (Paystack) ──────────────────────────────────────────────────────
# A key alone never activates billing - the matching switch must also be set:
#   test mode: sk_test_ key + ENABLE_TEST_BILLING=1 (no real money)
#   live mode: sk_live_ key + ENABLE_LIVE_BILLING=1 (real money!)
PAYSTACK_SECRET_KEY=sk_test_...
ENABLE_TEST_BILLING=1
# ENABLE_LIVE_BILLING=1
# Trusted base URL customers return to after paying (defaults to the hosted admin app)
PUBLIC_APP_URL=https://logistics.olyxee.com

# ─── Call centre (Retell, scaffolded/disabled) ───────────────────────────────
RETELL_API_KEY=your_retell_key
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret
RETELL_INTERNAL_TOKEN=your_retell_internal_token
